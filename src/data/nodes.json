	{
		"type": "data.merge",
		"label": "Merge",
		"description": "Merge data of multiple streams once data from all inputs is available",
		"category": "data",
		"icon": "Merge",
		"ports": {
			"in": ["input1", "input2"],
			"out": ["out"]
		},
		"credentialTypes": [],
		"actions": [
			"Append the items of the inputs",
			"Combine items by position",
			"Combine items by field",
			"Combine every item with every item",
			"Choose a branch"
		],
		"fields": [
			{
				"name": "mode",
				"type": "string",
				"required": false,
				"options": [
					"append",
					"combineByPosition",
					"combineByField",
					"combineAll",
					"chooseBranch"
				],
				"default": "append"
			},
			{
				"name": "numberInputs",
				"type": "integer",
				"description": "From 2 to 10. Lowering it removes the edges that go into the inputs that are gone.",
				"required": false,
				"default": 2
			},
			{
				"name": "matchFields",
				"type": "array",
				"description": "All pairs must match. With no pair, the field id is used",
				"required": false,
				"default": [
					{
						"field1": "id",
						"field2": "id"
					}
				]
			},
			{
				"name": "differentNames",
				"type": "boolean",
				"description": "Off: the name of input 1 is used for input 2 too",
				"required": false
			},
			{
				"name": "field1",
				"type": "string",
				"required": false
			},
			{
				"name": "field2",
				"type": "string",
				"required": false
			},
			{
				"name": "join",
				"type": "string",
				"required": false,
				"options": [
					"keepMatches",
					"keepNonMatches",
					"enrichInput1",
					"enrichInput2",
					"keepEverything",
					"keepAll"
				],
				"default": "keepMatches"
			},
			{
				"name": "multipleMatches",
				"type": "string",
				"required": false,
				"options": ["all", "first"]
			},
			{
				"name": "disableDotNotation",
				"type": "boolean",
				"description": "Off: \"a.b\" reads the key b inside the key a. On: it is the key \"a.b\"",
				"required": false
			},
			{
				"name": "fuzzyCompare",
				"type": "boolean",
				"description": "On: the number 1 and the text \"1\" are the same value",
				"required": false
			},
			{
				"name": "includeUnpaired",
				"type": "boolean",
				"description": "Off: only the positions that every input has",
				"required": false
			},
			{
				"name": "clash",
				"type": "string",
				"required": false,
				"options": ["preferInput2", "preferInput1", "suffix"]
			},
			{
				"name": "suffix1",
				"type": "string",
				"required": false
			},
			{
				"name": "suffix2",
				"type": "string",
				"required": false
			},
			{
				"name": "nested",
				"type": "string",
				"required": false,
				"options": ["shallow", "deep"]
			},
			{
				"name": "output",
				"type": "string",
				"required": false,
				"options": [
					"input1",
					"input2",
					"input3",
					"input4",
					"input5",
					"input6",
					"input7",
					"input8",
					"input9",
					"input10",
					"empty"
				],
				"default": "input1"
			}
		]
	},
