			},
			{
				"name": "responseCode",
				"type": "integer",
				"required": false
			},
			{
				"name": "responseData",
				"type": "string",
				"required": false
			},
			{
				"name": "responseHeaders",
				"type": "object",
				"required": false
			}
		]
	},
