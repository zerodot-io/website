			{
				"name": "httpMethod",
				"type": "string",
				"required": false,
				"options": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"],
				"default": "POST"
			},
			{
				"name": "path",
				"type": "string",
				"required": false
			},
			{
				"name": "authentication",
				"type": "string",
