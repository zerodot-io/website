			},
			{
				"name": "noResponseBody",
				"type": "boolean",
				"required": false
			},
			{
				"name": "onlyRunIf",
				"type": "string",
				"description": "An expression. The run starts when it is true.",
				"required": false
			},
			{
				"name": "rawBody",
				"type": "boolean",
				"required": false
			},
			{
				"name": "binaryProperty",
