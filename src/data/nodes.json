		"type": "trigger.http_poll",
		"label": "HTTP Poll",
		"description": "Check a JSON API on a timer and start a run for each new item",
		"category": "trigger",
		"icon": "RefreshCw",
		"ports": {
			"in": [],
			"out": ["out"]
		},
		"credentialTypes": [
			"http.basic",
			"http.bearer",
			"http.header",
			"oauth2.generic"
		],
		"actions": [],
		"fields": [
			{
				"name": "url",
				"type": "string",
				"required": true,
				"default": "https://"
			},
			{
				"name": "intervalSeconds",
				"type": "integer",
				"required": false,
				"default": 300
			},
			{
				"name": "itemsPath",
				"type": "string",
				"description": "Where the list is in the response, for example data.items. Empty: the response is the list.",
				"required": false,
				"default": ""
			},
			{
				"name": "keyPath",
				"type": "string",
				"description": "Where the unique id is inside an item, for example id. A key that was seen starts no run.",
				"required": true,
				"default": "id"
			},
			{
				"name": "newestFirst",
				"type": "boolean",
				"description": "Most APIs list the newest item first. Turn off when the oldest comes first.",
				"required": false,
				"default": true
			},
			{
				"name": "maxItems",
				"type": "integer",
				"description": "Only the newest items of the list are read.",
				"required": false,
				"default": 100
			}
		]
	},
