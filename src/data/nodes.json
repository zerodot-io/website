				"required": false,
				"options": ["immediate", "lastNode", "respondNode"],
				"default": "immediate"
			},
			{
				"name": "allowedOrigins",
				"type": "string",
				"description": "Comma separated. * allows all. https://*.example.com allows subdomains.",
